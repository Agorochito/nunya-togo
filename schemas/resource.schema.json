{
  "type": "object",
  "required": [
    "id",
    "title",
    "url",
    "provider",
    "type",
    "language",
    "license",
    "verified",
    "last_checked"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "verified": {
      "type": "boolean"
    },
    "language": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}