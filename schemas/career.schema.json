{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Career",
  "type": "object",
  "required": [
    "id",
    "domain_id",
    "title_fr",
    "summary_fr",
    "skills",
    "sources",
    "verified",
    "last_checked"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "domain_id": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "title",
          "source_type",
          "retrieved_on"
        ]
      }
    },
    "verified": {
      "type": "boolean"
    }
  }
}