{
  "type": "object",
  "required": [
    "id",
    "course",
    "module",
    "order",
    "minutes",
    "prerequisites",
    "outcomes",
    "body_fr",
    "examples",
    "exercises",
    "quiz",
    "glossary",
    "common_mistakes",
    "status",
    "reviewer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*-m[1-9][0-9]*-[0-9]{2}$"
    },
    "minutes": {
      "type": "integer",
      "minimum": 10,
      "maximum": 20
    },
    "body_fr": {
      "type": "array",
      "minItems": 3
    },
    "examples": {
      "type": "array",
      "minItems": 2
    },
    "exercises": {
      "type": "array",
      "minItems": 4
    },
    "quiz": {
      "type": "array",
      "minItems": 3
    },
    "glossary": {
      "type": "array",
      "minItems": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "brouillon",
        "relu",
        "validé"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}