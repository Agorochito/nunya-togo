    "kind": "project",
    "title_fr": "Le rapport d’évaluation",
    "instruction_fr": "Écris rapport(predictions, verites, positif) qui renvoie {\"exactitude\": ..., \"precision\": ..., \"rappel\": ...}, arrondis à 2 décimales, avec 0.0 quand un dénominateur est nul.",
    "starter_code": "def rapport(predictions, verites, positif):\n    return {}\n",
    "solution": "def rapport(predictions, verites, positif):\n    vp = sum(1 for p, v in zip(predictions, verites) if p == positif and v == positif)\n    fp = sum(1 for p, v in zip(predictions, verites) if p == positif and v != positif)\n    fn = sum(1 for p, v in zip(predictions, verites) if p != positif and v == positif)\n    justes = sum(1 for p, v in zip(predictions, verites) if p == v)\n    precision = vp / (vp + fp) if vp + fp else 0.0\n    rappel = vp / (vp + fn) if vp + fn else 0.0\n    return {\"exactitude\": round(justes / len(verites), 2), \"precision\": round(precision, 2), \"rappel\": round(rappel, 2)}\n",
