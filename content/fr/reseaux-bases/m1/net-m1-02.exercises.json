  {
    "kind": "project",
    "title_fr": "Diagnostic de passerelle",
    "instruction_fr": "Écris diagnostic(ip, prefixe, passerelle) : renvoie \"adresse réservée\" si ip est l’adresse de réseau ou de diffusion, sinon \"passerelle identique à l’adresse\" si les deux sont égales, sinon \"passerelle hors du réseau\" si elle n’y appartient pas, sinon \"ok\".",
    "starter_code": "def diagnostic(ip, prefixe, passerelle):\n    return \"ok\"\n",
    "solution": "import ipaddress\n\ndef diagnostic(ip, prefixe, passerelle):\n    reseau = ipaddress.ip_network(ip + \"/\" + str(prefixe), strict=False)\n    adresse = ipaddress.ip_address(ip)\n    if adresse in (reseau.network_address, reseau.broadcast_address):\n        return \"adresse réservée\"\n    if ip == passerelle:\n        return \"passerelle identique à l’adresse\"\n    if ipaddress.ip_address(passerelle) not in reseau:\n        return \"passerelle hors du réseau\"\n    return \"ok\"\n",
    "visible_tests": [
      {
        "inputs": [],
        "expected_output": "",
        "calls": [
          {
            "name": "diagnostic",
            "args": [
              "192.168.1.20",
              24,
              "192.168.1.1"
            ],
            "unchanged_args": true,
            "expected": "ok"
          },
          {
            "name": "diagnostic",
            "args": [
              "192.168.1.20",
              24,
              "192.168.2.1"
            ],
            "unchanged_args": true,
            "expected": "passerelle hors du réseau"
          }
        ]
      }
    ],
