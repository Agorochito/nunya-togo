  {
    "kind": "practice",
    "title_fr": "Niveaux d’un nom",
    "instruction_fr": "Écris niveaux(nom) qui renvoie la liste des domaines du plus général au plus précis : \"notes.ecole-avenir.tg\" donne [\"tg\", \"ecole-avenir.tg\", \"notes.ecole-avenir.tg\"].",
    "starter_code": "def niveaux(nom):\n    return nom.split(\".\")\n",
    "solution": "def niveaux(nom):\n    parties = nom.split(\".\")\n    return [\".\".join(parties[i:]) for i in range(len(parties) - 1, -1, -1)]\n",
