  {
    "kind": "guided",
    "title_fr": "Suivre les alias",
    "instruction_fr": "Écris resoudre(zone, nom) : zone associe un nom à [\"A\", ip] ou [\"CNAME\", autre nom]. Suis les CNAME jusqu’à un A et renvoie l’adresse ; renvoie None si un nom manque dans la zone.",
    "starter_code": "def resoudre(zone, nom):\n    return zone[nom][1]\n",
    "solution": "def resoudre(zone, nom):\n    while nom in zone:\n        genre, valeur = zone[nom]\n        if genre == \"A\":\n            return valeur\n        nom = valeur\n    return None\n",
    "visible_tests": [
      {
        "inputs": [],
        "expected_output": "",
        "calls": [
          {
            "name": "resoudre",
            "args": [
              {
                "ecole-avenir.tg": [
                  "A",
                  "41.207.160.5"
                ],
                "www.ecole-avenir.tg": [
                  "CNAME",
                  "ecole-avenir.tg"
                ],
                "notes.ecole-avenir.tg": [
                  "CNAME",
                  "www.ecole-avenir.tg"
                ],
                "mail.ecole-avenir.tg": [
                  "A",
                  "41.207.160.9"
                ]
              },
              "www.ecole-avenir.tg"
            ],
            "unchanged_args": true,
            "expected": "41.207.160.5"
          }
        ]
      }
    ],
    "hidden_tests": [
