    "solution": "def traverser(paquet, routeurs):\n    ttl = paquet[\"ttl\"] - routeurs\n    if ttl <= 0:\n        return None\n    copie = dict(paquet)\n    copie[\"ttl\"] = ttl\n    return copie\n",
