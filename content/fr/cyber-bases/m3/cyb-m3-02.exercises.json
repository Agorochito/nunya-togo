  {
    "kind": "project",
    "title_fr": "Valider une inscription",
    "instruction_fr": "Écris valider_inscription(formulaire) : formulaire est un dictionnaire avec \"identifiant\", \"telephone\" et \"age\" (textes). Renvoie la liste des erreurs, dans cet ordre : \"identifiant invalide\", \"téléphone invalide\", \"âge invalide\" (l’âge doit être un entier écrit en chiffres, de 10 à 99). Une liste vide signifie que tout est valide. Ne modifie pas le formulaire.",
    "starter_code": "def valider_inscription(formulaire):\n    return []\n",
    "solution": "import re\n\ndef valider_inscription(formulaire):\n    erreurs = []\n    if not re.fullmatch(r\"[a-z][a-z0-9_]{2,15}\", formulaire[\"identifiant\"]):\n        erreurs.append(\"identifiant invalide\")\n    if not re.fullmatch(r\"(\\+228)?\\d{8}\", formulaire[\"telephone\"].replace(\" \", \"\")):\n        erreurs.append(\"téléphone invalide\")\n    age = formulaire[\"age\"]\n    if not re.fullmatch(r\"\\d{2}\", age) or not 10 <= int(age) <= 99:\n        erreurs.append(\"âge invalide\")\n    return erreurs\n",
    "visible_tests": [
      {
        "inputs": [],
        "expected_output": "",
        "calls": [
          {
            "name": "valider_inscription",
            "args": [
              {
                "identifiant": "ama_2026",
                "telephone": "90 12 34 56",
                "age": "16"
              }
            ],
            "unchanged_args": true,
            "expected": []
          },
          {
            "name": "valider_inscription",
            "args": [
              {
                "identifiant": "Ama!",
                "telephone": "123",
                "age": "seize"
              }
            ],
            "unchanged_args": true,
            "expected": [
              "identifiant invalide",
              "téléphone invalide",
              "âge invalide"
            ]
          }
        ]
      }
    ],
    "hidden_tests": [
      {
        "inputs": [],
        "expected_output": "",
        "calls": [
          {
            "name": "valider_inscription",
            "args": [
              {
                "identifiant": "kofi",
                "telephone": "+22870112233",
                "age": "09"
              }
            ],
            "unchanged_args": true,
            "expected": [
              "âge invalide"
            ]
          },
          {
            "name": "valider_inscription",
            "args": [
