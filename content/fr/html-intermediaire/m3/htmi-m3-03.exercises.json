    "solution": "<main>\n  <h1>Documents visuels fictifs</h1>\n  <figure id=\"principal\">\n    <img id=\"plan\" src=\"data:image/svg+xml;base64,\" width=\"400\" height=\"200\" loading=\"eager\" alt=\"Potager à gauche, espace de rencontre circulaire à droite\">\n    <figcaption>Plan simplifié et fictif du jardin du club.</figcaption>\n  </figure>\n  <section>\n    <h2>Document complémentaire</h2>\n    <figure id=\"complement\">\n      <img id=\"detail\" src=\"data:image/svg+xml;base64,\" width=\"400\" height=\"200\" loading=\"lazy\" alt=\"Rectangle vert à gauche et cercle ocre à droite sur un fond clair\">\n      <figcaption>Illustration géométrique complémentaire, sans valeur de mesure.</figcaption>\n    </figure>\n  </section>\n</main>\n",
