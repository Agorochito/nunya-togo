    "solution": "<table id=\"places\">\n  <caption>Places fictives des ateliers</caption>\n  <thead>\n    <tr><th scope=\"col\">Atelier</th><th scope=\"col\">Places</th></tr>\n  </thead>\n  <tbody>\n    <tr><td>Semis</td><td>8</td></tr>\n    <tr><td>Compost</td><td>4</td></tr>\n  </tbody>\n</table>\n",
