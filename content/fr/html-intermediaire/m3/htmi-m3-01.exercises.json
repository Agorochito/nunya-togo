      "<main>\n  <h1>Programme du club</h1>\n  <p>Les disponibilités suivantes sont fictives.</p>\n  <table id=\"programme\">\n    <caption>Ateliers fictifs du week-end</caption>\n    <thead>\n      <tr><th scope=\"col\">Atelier</th><th scope=\"col\">Jour</th><th scope=\"col\">Places</th></tr>\n    </thead>\n    <tbody>\n      <tr><th scope=\"row\">Semis</th><td>Samedi</td><td>8</td></tr>\n      <tr><th scope=\"row\">Compost</th><td>Dimanche</td><td>4</td></tr>\n    </tbody>\n  </table>\n</main>"
