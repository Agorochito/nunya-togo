    "kind": "guided"
  },
  {
    "title_fr": "Limiter une section de droite à gauche",
    "instruction_fr": "Document français ltr. Crée section#invitation lang=ar dir=rtl, reliée au h2#titre-ar par aria-labelledby ; ce titre contient « أهلاً وسهلاً », p#message-ar « مرحباً ». Hors de cette section, p#texte-fr reste français. Dans p#reference, bdi#code dir=ltr contient CLUB-12. Préserve ces frontières et le h1.",
    "starter_code": "<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Directions — Club Rivage</title>\n  <meta name=\"description\" content=\"Annuaire fictif du club, sans collecte de données.\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n<body>\n<main id=\"contenu\">\n  <h1>Deux sens de lecture</h1>\n  <p id=\"texte-fr\">Présentation du club fictif.</p>\n  <section id=\"invitation\" lang=\"ar\" dir=\"ltr\" aria-labelledby=\"titre-ar\">\n    <h2 id=\"titre-ar\">أهلاً وسهلاً</h2>\n    <p id=\"message-ar\">مرحباً</p>\n  </section>\n  <p id=\"reference\">Référence : <bdi id=\"code\" dir=\"ltr\">CLUB-12</bdi></p>\n</main>\n</body>\n</html>",
    "solution": "<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Directions — Club Rivage</title>\n  <meta name=\"description\" content=\"Annuaire fictif du club, sans collecte de données.\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n<body>\n<main id=\"contenu\">\n  <h1>Deux sens de lecture</h1>\n  <p id=\"texte-fr\">Présentation du club fictif.</p>\n  <section id=\"invitation\" lang=\"ar\" dir=\"rtl\" aria-labelledby=\"titre-ar\">\n    <h2 id=\"titre-ar\">أهلاً وسهلاً</h2>\n    <p id=\"message-ar\">مرحباً</p>\n  </section>\n  <p id=\"reference\">Référence : <bdi id=\"code\" dir=\"ltr\">CLUB-12</bdi></p>\n</main>\n</body>\n</html>",
    "visible_tests": [
      {
        "description_fr": "La direction locale est réellement calculée",
        "checks": [
          {
            "selector": "html",
            "attributes": {
              "dir": "ltr",
              "lang": "fr"
            }
          },
          {
            "selector": "#invitation",
            "attributes": {
              "lang": "ar",
              "dir": "rtl",
              "aria-labelledby": "titre-ar"
            },
            "style": {
              "direction": "rtl"
            }
          }
        ]
      }
    ],
    "hidden_tests": [
      {
        "description_fr": "Titre et référence indépendante",
        "checks": [
          {
            "selector": "#titre-ar",
            "textIncludes": "أهلاً وسهلاً"
          },
          {
            "selector": "#message-ar",
            "textIncludes": "مرحباً"
          },
          {
            "selector": "#code",
            "attributes": {
              "dir": "ltr"
            },
            "style": {
              "direction": "ltr"
            }
          },
          {
            "selector": "#texte-fr",
            "style": {
              "direction": "ltr"
            }
          }
        ]
      }
    ],
    "hints": [
      "Une langue arabe ne modifie pas automatiquement dir.",
      "Le changement de sens doit concerner la section, pas html.",
      "Donne dir=rtl à #invitation et garde le code en ltr."
    ],
    "explanation_fr": "La variante vérifie aussi le texte extérieur : une réparation trop large qui retourne toute la page ne respecte pas le contrat.",
    "common_wrong_answers": [],
