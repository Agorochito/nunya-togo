[
  {
    "title_fr": "Déclarer la langue principale et une exception",
    "instruction_fr": "Produis un document complet en français : html lang=fr et dir=ltr. Dans main#contenu, h1 « Les langues du club », p#explication indiquant le français, et span#slogan lang=en contenant « Learning together ». Le span appartient à une phrase française. Ne change pas la langue de toute la page pour ce slogan.",
    "starter_code": "<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Langues — Club Rivage</title>\n  <meta name=\"description\" content=\"Annuaire fictif du club, sans collecte de données.\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n<body>\n<main id=\"contenu\">\n  <h1>Les langues du club</h1>\n  <p id=\"explication\">La page est rédigée en français.</p>\n  <p>Notre slogan invité : <span id=\"slogan\">Learning together</span>.</p>\n</main>\n</body>\n</html>",
    "solution": "<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Langues — Club Rivage</title>\n  <meta name=\"description\" content=\"Annuaire fictif du club, sans collecte de données.\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n<body>\n<main id=\"contenu\">\n  <h1>Les langues du club</h1>\n  <p id=\"explication\">La page est rédigée en français.</p>\n  <p>Notre slogan invité : <span id=\"slogan\" lang=\"en\">Learning together</span>.</p>\n</main>\n</body>\n</html>",
    "visible_tests": [
      {
        "description_fr": "Langues annoncées aux bons niveaux",
        "checks": [
          {
            "selector": "html",
            "attributes": {
              "lang": "fr",
              "dir": "ltr"
            }
          },
          {
            "selector": "#slogan",
            "attributes": {
              "lang": "en"
            },
            "textIncludes": "Learning together"
          }
        ]
      }
    ],
    "hidden_tests": [
      {
        "description_fr": "La structure française demeure",
        "checks": [
          {
            "selector": "main#contenu",
            "count": 1
          },
          {
            "selector": "#explication",
            "textIncludes": "français"
          },
          {
            "selector": "#contenu h1",
            "textIncludes": "Les langues du club"
          }
        ]
      }
    ],
    "hints": [
      "Sépare langue du document et langue d’une expression.",
      "Le slogan est le seul fragment anglais demandé.",
      "Place lang=fr sur html et lang=en sur span#slogan."
    ],
    "explanation_fr": "Le contrôle ne se limite pas à un texte visible : il inspecte aussi les attributs qui décrivent les langues.",
    "common_wrong_answers": [],
