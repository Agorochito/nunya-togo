    "instruction_fr": "Complète la page : ajoute la balise viewport dans head et le pied de page « Page fictive réalisée dans Nunya, 2026. » après main.",
    "starter_code": "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Ama Mensah — page personnelle</title>\n  <style>\n    :root {\n      --fond: #fdfaf5;\n      --texte: #1d1d1f;\n      --accent: #1f5e46;\n    }\n    body {\n      margin: 0;\n      font-family: system-ui, sans-serif;\n      font-size: 18px;\n      background-color: var(--fond);\n      color: var(--texte);\n    }\n    header,\n    main,\n    footer {\n      max-width: 720px;\n      margin: 0 auto;\n      padding: 16px;\n    }\n    nav {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n    h1,\n    h2 {\n      color: var(--accent);\n    }\n    img {\n      max-width: 100%;\n      height: auto;\n    }\n    .projets {\n      display: grid;\n      gap: 16px;\n    }\n    a:focus-visible {\n      outline: 3px solid var(--accent);\n    }\n    @media (min-width: 700px) {\n      nav {\n        flex-direction: row;\n      }\n      .projets {\n        grid-template-columns: 1fr 1fr;\n      }\n    }\n  </style>\n</head>\n<body>\n  <header>\n    <h1>Ama Mensah</h1>\n    <p>Élève en première, passionnée de code et de dessin.</p>\n  <nav aria-label=\"Sections de la page\">\n    <a href=\"#apropos\">À propos</a>\n    <a href=\"#projets\">Projets</a>\n    <a href=\"#contact\">Contact</a>\n  </nav>\n  </header>\n  <main>\n    <section id=\"apropos\">\n      <h2>À propos</h2>\n      <img src=\"portrait-ama.jpg\" alt=\"Portrait d’Ama Mensah souriante\" width=\"160\" height=\"160\">\n      <p>J’apprends à programmer depuis un an.</p>\n    </section>\n    <section id=\"projets\">\n      <h2>Projets</h2>\n      <div class=\"projets\">\n        <article><h3>Quiz de révision</h3><p>Un quiz en Python.</p></article>\n        <article><h3>Site du club</h3><p>Une page HTML et CSS.</p></article>\n      </div>\n    </section>\n    <section id=\"contact\">\n      <h2>Contact</h2>\n      <details>\n        <summary>Comment me joindre ?</summary>\n        <p><a href=\"mailto:ama.mensah@example.com\">Écrire à Ama</a></p>\n      </details>\n    </section>\n  </main>\n</body>\n</html>\n",
