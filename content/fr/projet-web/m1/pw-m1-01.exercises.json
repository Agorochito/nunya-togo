    "solution": "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Ama Mensah — page personnelle</title>\n</head>\n<body>\n  <header>\n    <h1>Ama Mensah</h1>\n    <p>Élève en première, passionnée de code et de dessin.</p>\n  <nav aria-label=\"Sections de la page\">\n    <a href=\"#apropos\">À propos</a>\n    <a href=\"#projets\">Projets</a>\n    <a href=\"#contact\">Contact</a>\n  </nav>\n  </header>\n  <main>\n    <section id=\"apropos\">\n      <h2>À propos</h2>\n    </section>\n    <section id=\"projets\">\n      <h2>Projets</h2>\n    </section>\n    <section id=\"contact\">\n      <h2>Contact</h2>\n    </section>\n  </main>\n  <footer>\n    <p>Page fictive réalisée dans Nunya, 2026.</p>\n  </footer>\n</body>\n</html>\n",
