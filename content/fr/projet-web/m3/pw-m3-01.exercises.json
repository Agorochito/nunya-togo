    "kind": "guided",
    "title_fr": "La balise viewport",
    "instruction_fr": "Ajoute dans head la balise meta name=\"viewport\" avec content=\"width=device-width, initial-scale=1\".",
    "starter_code": "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Ama Mensah — page personnelle</title>\n  <style>\n    nav {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n    @media (min-width: 700px) {\n      nav {\n        flex-direction: row;\n        gap: 24px;\n      }\n    }\n  </style>\n</head>\n<body>\n  <header>\n    <h1>Ama Mensah</h1>\n  <nav aria-label=\"Sections de la page\">\n    <a href=\"#apropos\">À propos</a>\n    <a href=\"#projets\">Projets</a>\n    <a href=\"#contact\">Contact</a>\n  </nav>\n  </header>\n</body>\n</html>\n",
    "solution": "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Ama Mensah — page personnelle</title>\n  <style>\n    nav {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n    @media (min-width: 700px) {\n      nav {\n        flex-direction: row;\n        gap: 24px;\n      }\n    }\n  </style>\n</head>\n<body>\n  <header>\n    <h1>Ama Mensah</h1>\n  <nav aria-label=\"Sections de la page\">\n    <a href=\"#apropos\">À propos</a>\n    <a href=\"#projets\">Projets</a>\n    <a href=\"#contact\">Contact</a>\n  </nav>\n  </header>\n</body>\n</html>\n",
