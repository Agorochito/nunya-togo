{
  "name": "nunya",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint dist/*.js scripts/*.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --globals",
    "check:content": "node scripts/check-content.mjs && node scripts/check-library.mjs",
    "check:academy": "node scripts/validate-academy.mjs",
    "test:e2e": "node scripts/test-academy-flow.mjs",
    "check:links": "node scripts/check-links.mjs",
    "build": "node scripts/build-academy.mjs",
    "lint:content": "node scripts/lint-curriculum.mjs",
    "test:code": "python3 scripts/test-curriculum-code.py",
    "check:prereqs": "node scripts/check-prereqs.mjs",
    "check:curriculum-links": "node scripts/check-curriculum-links.mjs",
    "check-links": "npm run check:curriculum-links && npm run check:links",
    "test:browser": "node scripts/test-web-exercises.mjs && node scripts/test-curriculum-global.mjs && node scripts/test-code-runtimes.mjs && node scripts/test-all-discovery-courses.mjs && node scripts/test-backup-onboarding.mjs && node scripts/test-library-offline.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "katex": "^0.19.1",
    "lighthouse": "^13.6.0",
    "marked": "^17.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
